{
    "layer": "top",
    "position": "bottom",
    "height": 26,
    "modules-left": ["niri/workspaces"],
	"modules-center": ["mpris"],
    "modules-right": ["privacy", "idle_inhibitor", "wireplumber", "battery", "clock"],
	"custom/run": {
		"format": "   ",
		"on-click": "pkill -x rofi || rofi -show drun",
		"tooltip": false
	},
	"niri/workspaces": {
		"format": "{value}"
	},
	"niri/window": {
		"format": "[]={app_id}",
		"rewrite": {
			"(.*)Cine": "Cine",
			"(.*)obsidian": "Obsidian",
			"(.*)Lollypop": "Lollypop",
			"(.*)Tuba": "Tuba",
			"(.*)planify": "Planify",
			"(.*)Nocturne": "Nocturne",
			"(.*)Nautilus": "Nautilus",
			"(.*)Loupe": "Loupe",
			"(.*)firefox": "Firefox"
		}
	},
	"mpris": {
		"format": "{status_icon} {dynamic}",
		"format-paused": "{status_icon} {dynamic}",
		"status-icons": {
			"playing": "  ",
			"paused": "⏸ "
		},
		"ignored-players": ["firefox"],
		"dynamic-len": 50,
		"dynamic-order": ["title", "artist"]
	},
    "clock": {
 		"tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%a %d %b  %I:%M %p}",
		"timezone": "America/Bogota",
		"locale": "es_CO.UTF-8"
    },
    "idle_inhibitor": {
        "format": "Caffeine: {icon}",
        "format-icons": {
            "activated": "[Active]",
            "deactivated": "[Disabled]"
        }
    },
	"cpu": {
        "format": "  {usage:02}",
        "interval": 2
    },
    "memory": {
        "format": "  {used:0.2f}",
        "interval": 2
    },
    "temperature": {
        "thermal-zone": 0,
        "hwmon-path": "/sys/class/hwmon/hwmon6/temp1_input",
		"interval": 2,
        "critical-threshold": 80,
        "format": "{icon} {temperatureC}°C",
        "format-icons": [""]
    },
    "backlight": {
        "format": "{icon} {percent}%",
        "format-icons": [" "]
    },
    "battery": {
        "states": {
			"good": 75,
            "warning": 20,
            "critical": 10
        },
        "interval": 10,
        "format": "BAT: {capacity:02}%",
        "format-charging": "[^] {capacity:02}%",
        "format-icons": ["|E|", "|_|", "|-|", "|=|", "|F|"],
		"tooltip-format": "{capacity:02}% {power:0.1f}W"
    },
	"network": {
        "format-wifi": "  {essid} {signaldBm}",
        "format-ethernet": "⇌  {ifname}: {ipaddr}",
        "format-disconnected": "⚠  Disconnected",
		// "on-click": "/sbin/networkmanager_dmenu",
        "interval": 5
    },
    "wireplumber": {
        "format": "Vol {volume:02}%",
        "format-muted": "Silent",
        "format-icons": {
            "headphones": " ",
            "default": [" "]
        }
    },
    "pulseaudio": {
        "format": "vol: {volume}%",
        "format-bluetooth": "{volume}% 󰥰 ",
        "format-muted": " ",
        "format-icons": {
            "headphones": " ",
            "default": ["", " ", " "]
        }
        // "on-click": "pavucontrol"
    },
	"privacy": {
		"icon-spacing": 2,
		"icon-size": 14,
		"modules": [
			{
				"type": "screenshare"
			},
			{
				"type": "audio-in"
			}
		]
	}
}
